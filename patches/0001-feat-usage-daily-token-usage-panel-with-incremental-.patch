@@ -0,0 +1,46 @@
+/**
+ * usage domain zod schemas. Read-only shapes: the request carries the day
+ * window and grouping, and the value is the aggregated rows plus grand total.
+ */
+
+import { z } from 'zod'
+import type { Wire } from './rpc.schema.ts'
+import type { RequestPayload, ResponseValue } from './index.ts'
+
+/** usage.query groupBy dimension. */
+export const usageDimensionSchema = z.enum(['day', 'model', 'session'])
+
+/** usage.query day-bound literal. */
+export const usageDateSchema = z.string().regex(/^\d{4}-\d{2}-\d{2}$/, 'expected YYYY-MM-DD')
+
+/** usage.query request payload. */
+export const usageQueryRequestSchema = z.object({
+  from: usageDateSchema.optional(),
+  to: usageDateSchema.optional(),
+  asOf: z.number().int().positive().optional(),
+  groupBy: z.array(usageDimensionSchema).min(1),
+}) as unknown as z.ZodType<Wire<RequestPayload<'usage.query'>>>
+
+/** usage.query token-bucket totals. */
+export const usageTokenTotalsSchema = z.object({
+  inputTokens: z.number().int().nonnegative(),
+  outputTokens: z.number().int().nonnegative(),
+  cacheReadTokens: z.number().int().nonnegative(),
+  cacheWriteTokens: z.number().int().nonnegative(),
+  reasoningTokens: z.number().int().nonnegative(),
+  totalTokens: z.number().int().nonnegative(),
+})
+
+/** usage.query result row (dimension fields present only when grouped). */
+export const usageRowSchema = usageTokenTotalsSchema.extend({
+  day: z.string().optional(),
+  model: z.string().optional(),
+  sessionId: z.string().optional(),
+  requests: z.number().int().nonnegative(),
+})
+
+/** usage.query response value. */
+export const usageQueryValueSchema = z.object({
+  rows: z.array(usageRowSchema),
+  total: usageTokenTotalsSchema,
+}) as unknown as z.ZodType<Wire<ResponseValue<'usage.query'>>>
diff --git a/packages/host/apiproxy/src/api/usage.ts b/packages/host/apiproxy/src/api/usage.ts
new file mode 100644
index 0000000..f7908a4
--- /dev/null
+++ b/packages/host/apiproxy/src/api/usage.ts
@@ -0,0 +1,73 @@
+/**
+ * usage domain contract: read-only cross-session token-usage aggregation.
+ * Method signatures are the source of truth: unary methods take the
+ * RpcRequest<P> narrow form and the impl echoes rpcId.
+ *
+ * The domain has no session argument: the aggregation spans the whole logical
+ * corpus, and the day window is the machine's local calendar. View shapes are
+ * defined here (browser-safe, zero host imports) and mirror the
+ * `@deepseek-ai/dsh-usage-query` service vocabulary.
+ */
+
+import type { RpcRequest, RpcResponse } from './rpc.ts'
+
+/** A grouping dimension: one optional column of every result row. */
+export type UsageDimension = 'day' | 'model' | 'session'
+
+/** Summed token buckets for one group. */
+export interface UsageTokenTotals {
+  /** Uncached input tokens. */
+  inputTokens: number
+  /** Output tokens. */
+  outputTokens: number
+  /** Cache-read tokens. */
+  cacheReadTokens: number
+  /** Cache-write tokens. */
+  cacheWriteTokens: number
+  /** Reasoning output tokens (already inside `outputTokens`; reported separately). */
+  reasoningTokens: number
+  /** Disjoint sum of all four buckets. */
+  totalTokens: number
+}
+
+/** One aggregated group: exactly the requested dimensions plus sums. */
+export interface UsageRow extends UsageTokenTotals {
+  /** Local `YYYY-MM-DD` of the samples; present iff `day` is grouped. */
+  readonly day?: string
+  /** `provider/model` of the samples; present iff `model` is grouped. */
+  readonly model?: string
+  /** Owning session id; present iff `session` is grouped. */
+  readonly sessionId?: string
+  /** Number of usage samples (provider-reported calls) in the group. */
+  readonly requests: number
+}
+
+/** Aggregated rows (sorted deterministically) plus the grand total. */
+export interface UsageQueryResult {
+  /** One row per distinct group, sorted by the grouped dimensions. */
+  readonly rows: readonly UsageRow[]
+  /** Grand total across every row. */
+  readonly total: UsageTokenTotals
+}
+
+/**
+ * Usage-domain unary methods. `query` is read-only: it never creates or
+ * resumes an agent, never touches prompts, and never sends provider requests.
+ */
+export interface UsageApi {
+  /** Aggregate provider-reported token usage across the logical corpus. */
+  query(request: RpcRequest<{
+    /** Inclusive lower bound as a local `YYYY-MM-DD` date; absent = no bound. */
+    from?: string
+    /** Inclusive upper bound as a local `YYYY-MM-DD` date; absent = no bound. */
+    to?: string
+    /**
+     * Epoch-ms cutoff: only samples at or before this instant count. The
+     * panel captures it when it opens, freezing the view against usage
+     * produced afterwards.
+     */
+    asOf?: number
+    /** Non-empty, duplicate-free grouping dimension subset. */
+    groupBy: readonly UsageDimension[]
+  }>): Promise<RpcResponse<UsageQueryResult>>
+}
