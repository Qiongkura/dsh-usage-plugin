+import { describe, expect, it } from 'vitest'
+import { scanRawUsageEvents } from '../src/raw.ts'
+
+const line = (data: Record<string, unknown>): string => JSON.stringify({
+  type: 'assistant/message', seq: 0, time: 1755230400000, data,
+})
+
+describe('scanRawUsageEvents', () => {
+  it('extracts headers, usage messages, and usage chunks in line order', () => {
+    const content = [
+      JSON.stringify({ type: 'request/header', seq: 0, time: 1, data: { header: { config: { provider: 'deepseek', model: 'deepseek-chat' } }, reason: 'turn' } }),
+      line({ turn: 1, step: 1, message: { role: 'assistant' }, usage: { inputTokens: 10, outputTokens: 5 } }),
+      JSON.stringify({ type: 'assistant/chunk', seq: 2, time: 3, data: { index: 0, turn: 2, step: 1, chunk: { type: 'usage', usage: { inputTokens: 7 } } } }),
+    ].join('\n')
+    const events = scanRawUsageEvents(content)
+    expect(events).toHaveLength(3)
+    expect(events[0]).toMatchObject({ type: 'request/header', data: { header: { config: { provider: 'deepseek', model: 'deepseek-chat' } } } })
+    expect(events[1]).toMatchObject({ type: 'assistant/message', time: 1755230400000, data: { turn: 1, step: 1, usage: { inputTokens: 10 } } })
+    expect(events[2]).toMatchObject({ type: 'assistant/chunk', data: { turn: 2, step: 1, chunk: { type: 'usage', usage: { inputTokens: 7 } } } })
+  })
+
+  it('skips messages without usage, non-usage chunks, packed rows, and other events', () => {
+    const content = [
+      line({ turn: 1, step: 1, message: { role: 'assistant' } }),
+      '{"type":"assistant/message","seq":5,"time":6}',
+      JSON.stringify({ type: 'assistant/chunk', seq: 1, time: 2, data: { index: 0, turn: 1, step: 1, chunk: { type: 'text-delta', index: 0, text: 'x' } } }),
+      JSON.stringify({ type: 'text-chunks', seq: 2, time: 3, data: { index: 0, turn: 1, step: 1, chunks: [] } }),
+      JSON.stringify({ type: 'user/message', seq: 3, time: 4, data: { turn: 1, message: { role: 'user' } } }),
+    ].join('\n')
+    expect(scanRawUsageEvents(content)).toEqual([])
+  })
+
+  it('skips a header without a resolvable call configuration', () => {
+    const content = [
+      JSON.stringify({ type: 'request/header', seq: 0, time: 1, data: { header: {}, reason: 'turn' } }),
+      JSON.stringify({ type: 'request/header', seq: 1, time: 2, data: { header: { config: { provider: 'deepseek' } }, reason: 'turn' } }),
+    ].join('\n')
+    expect(scanRawUsageEvents(content)).toEqual([])
+  })
+
+  it('skips torn and non-JSON tail lines instead of failing', () => {
+    const content = [
+      line({ turn: 1, step: 1, message: { role: 'assistant' }, usage: { inputTokens: 10, outputTokens: 5 } }),
+      '{"type":"assistant/message", "seq": 1, "time": 2, "data": {"turn": 1, "step": 1, "usage": {"inputTokens": 9',
+      'not json at all',
+      '',
+    ].join('\n')
+    const events = scanRawUsageEvents(content)
+    expect(events).toHaveLength(1)
+  })
+
+  it('returns no events for empty content', () => {
+    expect(scanRawUsageEvents('')).toEqual([])
+    expect(scanRawUsageEvents('\n\n')).toEqual([])
+  })
+})
diff --git a/packages/usage/usage-query/tests/usage-query.spec.ts b/packages/usage/usage-query/tests/usage-query.spec.ts
