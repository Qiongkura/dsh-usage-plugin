+      rawSupported: false,
+      readCalls: reads,
+    })
+    try {
+      const result = await ctx.usageQuery.query({ groupBy: ['day'] })
+      expect(reads).toEqual(['s-1'])
+      expect(result.total.totalTokens).toBe(150)
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('folds live sessions from their in-memory log without replay or raw reads', async () => {
+    const reads: string[] = []
+    const { ctx, dispose } = await mount(['s-live', 's-2'], {
+      snapshotSource: () => ({ 's-live': 'r', 's-2': 'r' }),
+      rawArtifacts: { 's-live': 'unused' },
+      liveSessions: {
+        's-live': [
+          header(0, 'deepseek', 'deepseek-chat', noon(2026, 8, 15)),
+          message(1, 1, 1, noon(2026, 8, 15), usage({ inputTokens: 42 })),
+        ],
+      },
+      readCalls: reads,
+    })
+    try {
+      const result = await ctx.usageQuery.query({ groupBy: ['day'] })
+      // The live session folded from memory; only the persisted s-2 was read.
+      expect(reads).toEqual(['s-2'])
+      expect(result.total.inputTokens).toBe(49)
+    } finally {
+      await dispose()
+    }
+  })
+})
