diff --git a/scripts/watch-web.ps1 b/scripts/watch-web.ps1
new file mode 100644
index 0000000..20f8568
--- /dev/null
+++ b/scripts/watch-web.ps1
@@ -0,0 +1,78 @@
+# Supervises the dsh web server: starts it from the built CLI, restarts it on
+# unexpected exit with backoff, and keeps timestamped logs for each run.
+[CmdletBinding()]
+param(
+  [int]$Port = 3080,
+  [int]$MaxBackoffSeconds = 30,
+  [int]$StableSeconds = 60
+)
+
+$ErrorActionPreference = 'Stop'
+$root = Split-Path -Parent $PSScriptRoot
+$node = (Get-Command node -ErrorAction Stop).Source
+$bin = Join-Path $root 'apps\cli\lib\bin.js'
+$watchLog = Join-Path $root 'dsh-web.watch.log'
+$watchPidFile = Join-Path $root 'dsh-web.watch.pid'
+$childPidFile = Join-Path $root 'dsh-web.child.pid'
+
+function Write-WatchLog([string]$Message) {
+  $line = '{0} {1}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Message
+  Add-Content -LiteralPath $watchLog -Value $line
+}
+
+Set-Content -LiteralPath $watchPidFile -Value $PID
+Write-WatchLog "watchdog started (pid $PID, port $Port)"
+
+$backoff = 1
+$lastStartedAt = $null
+
+while ($true) {
+  if (Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue) {
+    Write-WatchLog "port $Port is already listening; stopping watchdog"
+    Remove-Item -LiteralPath $watchPidFile -Force -ErrorAction SilentlyContinue
+    break
+  }
+
+  $stamp = Get-Date -Format 'yyyyMMdd-HHmmss'
+  $outLog = Join-Path $root "dsh-web.$stamp.out.log"
+  $errLog = Join-Path $root "dsh-web.$stamp.err.log"
+  $serverArgs = @(('"{0}"' -f $bin), 'web', '--port', "$Port")
+  $server = Start-Process -FilePath $node -ArgumentList $serverArgs -WorkingDirectory $root -RedirectStandardOutput $outLog -RedirectStandardError $errLog -WindowStyle Hidden -PassThru
+  Set-Content -LiteralPath $childPidFile -Value $server.Id
+  $startedAt = Get-Date
+  Write-WatchLog "started server pid $($server.Id), logs dsh-web.$stamp.*.log (backoff $backoff s)"
+
+  $listened = $false
+  while (-not $server.HasExited) {
+    Start-Sleep -Milliseconds 500
+    if (Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue) {
+      $listened = $true
+      break
+    }
+  }
+
+  if ($listened) {
+    $backoff = 1
+    Write-WatchLog "server pid $($server.Id) is listening on port $Port"
+    while (-not $server.HasExited) {
+      Start-Sleep -Seconds 1
+    }
+    if ((Get-Date) - $startedAt -ge [TimeSpan]::FromSeconds($StableSeconds)) {
+      $backoff = 1
+    }
+  }
+
+  $exitCode = $server.ExitCode
+  Remove-Item -LiteralPath $childPidFile -Force -ErrorAction SilentlyContinue
+  Write-WatchLog "server pid $($server.Id) exited with code $exitCode"
+  if ((Test-Path -LiteralPath $errLog) -and (Get-Item -LiteralPath $errLog).Length -gt 0) {
+    foreach ($line in (Get-Content -LiteralPath $errLog -Tail 15)) {
+      Write-WatchLog "  $line"
+    }
+  }
+
+  if ((Get-Date) - $startedAt -lt [TimeSpan]::FromSeconds($StableSeconds)) {
+    Start-Sleep -Seconds $backoff
+    $backoff = [Math]::Min($backoff * 2, $MaxBackoffSeconds)
+  }
+}
