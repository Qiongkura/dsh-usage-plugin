diff --git a/scripts/start-web.ps1 b/scripts/start-web.ps1
new file mode 100644
index 0000000..a3db981
--- /dev/null
+++ b/scripts/start-web.ps1
@@ -0,0 +1,66 @@
+# Starts dsh web from a built checkout, launches a hidden watchdog that keeps
+# the server alive, waits for the port, and optionally opens the browser.
+[CmdletBinding()]
+param(
+  [int]$Port = 3080,
+  [switch]$OpenBrowser,
+  [switch]$SkipBuild
+)
+
+$ErrorActionPreference = 'Stop'
+$root = Split-Path -Parent $PSScriptRoot
+$url = "http://127.0.0.1:$Port"
+$watchScript = Join-Path $root 'scripts\watch-web.ps1'
+$watchLog = Join-Path $root 'dsh-web.watch.log'
+$watchOutLog = Join-Path $root 'dsh-web.watch.out.log'
+$watchErrLog = Join-Path $root 'dsh-web.watch.err.log'
+$watchPidFile = Join-Path $root 'dsh-web.watch.pid'
+$bin = Join-Path $root 'apps\cli\lib\bin.js'
+$builtIndex = Join-Path $root 'packages\bundle\web-app\node_modules\@deepseek-ai\dsh-web-frontend\dist\index.html'
+
+if (Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue) {
+  Write-Host "dsh web: already running at $url"
+  if ($OpenBrowser) { Start-Process $url }
+  exit 0
+}
+
+if (-not $SkipBuild -and (-not (Test-Path $bin) -or -not (Test-Path $builtIndex))) {
+  Write-Host 'dsh web: building missing web bundles (pnpm run build)...'
+  Push-Location $root
+  try {
+    & pnpm run build
+    if ($LASTEXITCODE -ne 0) { throw "pnpm run build failed with exit code $LASTEXITCODE" }
+  } finally {
+    Pop-Location
+  }
+}
+
+if (-not (Test-Path $bin)) {
+  throw "Missing built CLI: $bin. Run pnpm run build first or drop -SkipBuild."
+}
+
+Remove-Item -LiteralPath $watchPidFile -Force -ErrorAction SilentlyContinue
+
+$shell = Get-Command powershell.exe -ErrorAction SilentlyContinue
+if (-not $shell) { $shell = Get-Command pwsh -ErrorAction Stop }
+$watchArgs = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', ('"{0}"' -f $watchScript), '-Port', "$Port")
+$watcher = Start-Process -FilePath $shell.Source -ArgumentList $watchArgs -WorkingDirectory $root -RedirectStandardOutput $watchOutLog -RedirectStandardError $watchErrLog -WindowStyle Hidden -PassThru
+Set-Content -LiteralPath $watchPidFile -Value $watcher.Id
+Write-Host "dsh web: watchdog pid $($watcher.Id)"
+
+for ($attempt = 0; $attempt -lt 90; $attempt++) {
+  Start-Sleep -Seconds 1
+  if (Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue) {
+    Write-Host "dsh web: $url"
+    if ($OpenBrowser) { Start-Process $url }
+    exit 0
+  }
+  if ($watcher.HasExited) {
+    Write-Host "dsh web: watchdog exited with code $($watcher.ExitCode); recent log:"
+    if (Test-Path $watchLog) { Get-Content $watchLog -Tail 40 }
+    exit 1
+  }
+}
+
+Write-Host "dsh web: did not listen on port $Port within 90s; see $watchLog"
+exit 1
diff --git a/scripts/stop-web.ps1 b/scripts/stop-web.ps1
new file mode 100644
index 0000000..8c6ffa7
--- /dev/null
+++ b/scripts/stop-web.ps1
@@ -0,0 +1,41 @@
+# Stops the dsh web watchdog and the server it supervises.
+[CmdletBinding()]
+param([int]$Port = 3080)
+
+$ErrorActionPreference = 'Stop'
+$root = Split-Path -Parent $PSScriptRoot
+$watchPidFile = Join-Path $root 'dsh-web.watch.pid'
+$childPidFile = Join-Path $root 'dsh-web.child.pid'
+
+function Stop-PidFile([string]$Path, [string]$Label) {
+  if (-not (Test-Path -LiteralPath $Path)) { return }
+  $pidValue = Get-Content -LiteralPath $Path | Select-Object -First 1
+  if ($pidValue -match '^\d+$') {
+    $proc = Get-Process -Id ([int]$pidValue) -ErrorAction SilentlyContinue
+    if ($proc) {
+      Stop-Process -Id ([int]$pidValue) -Force -ErrorAction SilentlyContinue
+      Write-Host "stopped $Label pid $pidValue"
+    }
+  }
+  Remove-Item -LiteralPath $Path -Force -ErrorAction SilentlyContinue
+}
+
+# Stop the watchdog first so it cannot restart the child.
+Stop-PidFile $watchPidFile 'watchdog'
+Start-Sleep -Milliseconds 300
+Stop-PidFile $childPidFile 'server'
+
+$listener = Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1
+if ($listener) {
+  $owner = Get-CimInstance Win32_Process -Filter "ProcessId = $($listener.OwningProcess)" -ErrorAction SilentlyContinue
+  if ($owner -and $owner.CommandLine -match 'deepseek-harness|apps[\\/]cli|dsh[\\/]bin') {
+    Stop-Process -Id $listener.OwningProcess -Force -ErrorAction SilentlyContinue
+    Write-Host "stopped orphaned server pid $($listener.OwningProcess)"
+  }
+}
+
+if (Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue) {
+  Write-Host "dsh web: port $Port is still in use by another process"
+} else {
+  Write-Host "dsh web: stopped (port $Port)"
+}
