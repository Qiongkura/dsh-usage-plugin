+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { SessionQueryEngine } from '@deepseek-ai/dsh-session-query'
+import { UsageQuery } from '../src/index.ts'
+import {
+  UNKNOWN_MODEL,
+  aggregateSamples,
+  dayKey,
+  foldUsageSamples,
+  usageSampleOf,
+  validateRequest,
+} from '../src/fold.ts'
+import type { TaggedSample } from '../src/types.ts'
+
+/** Local-noon timestamp: the calendar day is the same in every timezone. */
+const noon = (y: number, m: number, d: number): number => new Date(y, m - 1, d, 12).getTime()
+
+const usage = (over: Partial<Record<'inputTokens' | 'outputTokens' | 'cacheReadTokens' | 'cacheWriteTokens' | 'reasoningTokens', number>> = {}) => ({
+  inputTokens: 100,
+  outputTokens: 50,
+  ...over,
+})
+
+const message = (seq: number, turn: number, step: number, time: number, u: ReturnType<typeof usage>): SessionEvent => ({
+  type: 'assistant/message',
+  seq,
+  time,
+  data: { turn, step, message: { role: 'assistant', blocks: [{ type: 'text', text: 'ok' }] }, usage: u },
+}) as SessionEvent
+
+const chunk = (seq: number, turn: number, step: number, time: number, u: ReturnType<typeof usage>): SessionEvent => ({
+  type: 'assistant/chunk',
+  seq,
+  time,
+  data: { index: 0, turn, step, chunk: { type: 'usage', usage: u } },
+}) as SessionEvent
+
+const header = (seq: number, provider: string, model: string, time: number): SessionEvent => ({
+  type: 'request/header',
+  seq,
+  time,
+  data: { header: { config: { provider, model } }, reason: 'turn' },
+}) as SessionEvent
+
+const other = (seq: number, time: number): SessionEvent => ({
+  type: 'user/message',
+  seq,
+  time,
+  data: { turn: 1, message: { role: 'user', blocks: [{ type: 'text', text: 'hi' }] } },
+}) as SessionEvent
+
+const tagged = (sessionId: string, sample: ReturnType<typeof foldUsageSamples>[number]): TaggedSample =>
+  ({ ...sample, sessionId })
+
+describe('dayKey', () => {
+  it('formats the local calendar day with zero padding', () => {
+    expect(dayKey(noon(2026, 8, 15))).toBe('2026-08-15')
+    expect(dayKey(noon(2026, 1, 3))).toBe('2026-01-03')
+  })
+
+  it('crosses a year boundary', () => {
+    expect(dayKey(noon(2026, 1, 1))).toBe('2026-01-01')
+    expect(dayKey(noon(2025, 12, 31))).toBe('2025-12-31')
+  })
+})
+
+describe('usageSampleOf', () => {
+  it('reads the final usage of an assistant message', () => {
+    expect(usageSampleOf(message(0, 1, 1, noon(2026, 8, 15), usage()))?.usage).toMatchObject({ inputTokens: 100 })
+  })
+
+  it('reads a streaming usage chunk', () => {
+    expect(usageSampleOf(chunk(0, 1, 1, noon(2026, 8, 15), usage()))?.usage).toMatchObject({ outputTokens: 50 })
+  })
+
+  it('returns undefined for messages without usage and for non-usage chunks', () => {
+    expect(usageSampleOf({ type: 'assistant/message', seq: 0, time: 1, data: { turn: 1, step: 1, message: { role: 'assistant', blocks: [] } } } as SessionEvent)).toBeUndefined()
+    expect(usageSampleOf({ type: 'assistant/chunk', seq: 0, time: 1, data: { index: 0, turn: 1, step: 1, chunk: { type: 'text-delta', index: 0, text: 'x' } } } as SessionEvent)).toBeUndefined()
+  })
+
+  it('returns undefined for events that never carry usage', () => {
+    expect(usageSampleOf(other(0, noon(2026, 8, 15)))).toBeUndefined()
+  })
+})
+
+describe('foldUsageSamples', () => {
+  it('attributes usage to the newest request header', () => {
+    const events = [
+      header(0, 'deepseek', 'deepseek-chat', noon(2026, 8, 15)),
+      message(1, 1, 1, noon(2026, 8, 15), usage()),
+    ]
+    const samples = foldUsageSamples(events)
+    expect(samples).toHaveLength(1)
+    expect(samples[0]).toMatchObject({ turn: 1, step: 1, model: 'deepseek/deepseek-chat' })
+  })
+
+  it('labels headerless usage as unknown', () => {
+    const samples = foldUsageSamples([message(0, 1, 1, noon(2026, 8, 15), usage())])
+    expect(samples[0]!.model).toBe(UNKNOWN_MODEL)
+  })
+
+  it('lets a final message usage replace the same-step streaming sample', () => {
+    const events = [
+      header(0, 'deepseek', 'deepseek-chat', noon(2026, 8, 15)),
+      chunk(1, 1, 1, noon(2026, 8, 15), usage({ inputTokens: 9, outputTokens: 1 })),
+      message(2, 1, 1, noon(2026, 8, 15), usage({ inputTokens: 12, outputTokens: 3 })),
+    ]
+    const samples = foldUsageSamples(events)
+    expect(samples).toHaveLength(1)
+    expect(samples[0]!.usage).toMatchObject({ inputTokens: 12, outputTokens: 3 })
+  })
+
+  it('keeps one sample per distinct step', () => {
+    const events = [
+      header(0, 'deepseek', 'deepseek-chat', noon(2026, 8, 15)),
+      message(1, 1, 1, noon(2026, 8, 15), usage()),
+      message(2, 2, 1, noon(2026, 8, 15), usage({ inputTokens: 7, outputTokens: 2 })),
+    ]
+    const samples = foldUsageSamples(events)
+    expect(samples).toHaveLength(2)
+    expect(samples.map(s => s.step)).toEqual([1, 1])
+    expect(samples[1]!.usage.inputTokens).toBe(7)
+  })
+
+  it('retains a usage chunk when no final message follows', () => {
+    const samples = foldUsageSamples([chunk(0, 1, 1, noon(2026, 8, 15), usage({ inputTokens: 9 }))])
+    expect(samples).toHaveLength(1)
+    expect(samples[0]!.usage.inputTokens).toBe(9)
+  })
+
+  it('keeps the event time of the surviving sample', () => {
+    const time = noon(2026, 8, 15)
+    const samples = foldUsageSamples([message(0, 1, 1, time, usage())])
+    expect(samples[0]!.time).toBe(time)
+  })
+
+  it('skips events that carry no usage', () => {
+    const time = noon(2026, 8, 15)
+    const samples = foldUsageSamples([other(0, time), message(1, 1, 1, time, usage())])
+    expect(samples).toHaveLength(1)
+    expect(foldUsageSamples([other(0, time)])).toEqual([])
+  })
+})
+
+describe('validateRequest', () => {
+  it('rejects an empty groupBy', () => {
+    expect(validateRequest({ groupBy: [] })).toMatch(/at least one/)
+  })
+
+  it('rejects an unknown dimension', () => {
+    expect(validateRequest({ groupBy: ['hour'] as never })).toMatch(/unknown dimension/)
+  })
+
+  it('rejects a duplicate dimension', () => {
+    expect(validateRequest({ groupBy: ['day', 'day'] })).toMatch(/duplicate/)
+  })
+
+  it('rejects malformed dates and inverted windows', () => {
+    expect(validateRequest({ groupBy: ['day'], from: '2026-8-1' })).toMatch(/invalid from/)
+    expect(validateRequest({ groupBy: ['day'], to: 'yesterday' })).toMatch(/invalid to/)
+    expect(validateRequest({ groupBy: ['day'], from: '2026-08-16', to: '2026-08-15' })).toMatch(/after/)
+  })
+
+  it('rejects a malformed as-of cutoff and accepts a valid one', () => {
+    expect(validateRequest({ groupBy: ['day'], asOf: 0 })).toMatch(/invalid asOf/)
+    expect(validateRequest({ groupBy: ['day'], asOf: -5 })).toMatch(/invalid asOf/)
+    expect(validateRequest({ groupBy: ['day'], asOf: 1.5 })).toMatch(/invalid asOf/)
+    expect(validateRequest({ groupBy: ['day'], asOf: noon(2026, 8, 15) })).toBeUndefined()
+  })
+
+  it('accepts a valid request with no dates', () => {
+    expect(validateRequest({ groupBy: ['day', 'model'] })).toBeUndefined()
+  })
+})
+
+describe('aggregateSamples', () => {
+  const a = tagged('s-1', { turn: 1, step: 1, time: noon(2026, 8, 15), usage: usage(), model: 'deepseek/deepseek-chat' })
+  const b = tagged('s-1', { turn: 2, step: 1, time: noon(2026, 8, 14), usage: usage({ inputTokens: 7, cacheReadTokens: 3, reasoningTokens: 2 }), model: 'deepseek/deepseek-reasoner' })
+  const c = tagged('s-2', { turn: 1, step: 1, time: noon(2026, 8, 15), usage: usage({ inputTokens: 1, outputTokens: 1, cacheWriteTokens: 4 }), model: 'deepseek/deepseek-chat' })
+
+  it('groups by day only and sums buckets plus requests', () => {
+    const { rows, total } = aggregateSamples({ groupBy: ['day'] }, [a, b, c])
+    expect(rows).toEqual([
+      { day: '2026-08-14', requests: 1, inputTokens: 7, outputTokens: 50, cacheReadTokens: 3, cacheWriteTokens: 0, reasoningTokens: 2, totalTokens: 60 },
+      { day: '2026-08-15', requests: 2, inputTokens: 101, outputTokens: 51, cacheReadTokens: 0, cacheWriteTokens: 4, reasoningTokens: 0, totalTokens: 156 },
+    ])
+    expect(total).toEqual({
+      inputTokens: 108, outputTokens: 101, cacheReadTokens: 3, cacheWriteTokens: 4,
+      reasoningTokens: 2, totalTokens: 216,
+    })
+  })
+
+  it('groups by model, session, and every combination', () => {
+    const byModel = aggregateSamples({ groupBy: ['model'] }, [a, b, c]).rows
+    expect(byModel.map(r => [r.model, r.requests])).toEqual([
+      ['deepseek/deepseek-chat', 2],
+      ['deepseek/deepseek-reasoner', 1],
+    ])
+    const bySession = aggregateSamples({ groupBy: ['session'] }, [a, b, c]).rows
+    expect(bySession.map(r => [r.sessionId, r.requests])).toEqual([['s-1', 2], ['s-2', 1]])
+    const byDayModel = aggregateSamples({ groupBy: ['day', 'model'] }, [a, b, c]).rows
+    expect(byDayModel).toHaveLength(2)
+    expect(byDayModel[0]).toMatchObject({ day: '2026-08-14', model: 'deepseek/deepseek-reasoner' })
+    expect(byDayModel[1]).toMatchObject({ day: '2026-08-15', model: 'deepseek/deepseek-chat', requests: 2 })
+    const byModelSession = aggregateSamples({ groupBy: ['model', 'session'] }, [a, b, c]).rows
+    expect(byModelSession).toHaveLength(3)
+    expect(byModelSession[0]).toMatchObject({ model: 'deepseek/deepseek-chat', sessionId: 's-1' })
+    const full = aggregateSamples({ groupBy: ['day', 'model', 'session'] }, [a, b, c]).rows
+    expect(full).toHaveLength(3)
+    expect(full[0]).toMatchObject({ day: '2026-08-14', model: 'deepseek/deepseek-reasoner', sessionId: 's-1' })
+  })
+
+  it('applies the inclusive day window before grouping', () => {
+    const { rows, total } = aggregateSamples({ groupBy: ['day'], from: '2026-08-15', to: '2026-08-15' }, [a, b, c])
+    expect(rows.map(r => r.day)).toEqual(['2026-08-15'])
+    expect(total.inputTokens).toBe(101)
+  })
+
+  it('cuts usage after the as-of moment, inclusive at the boundary', () => {
+    const cutoff = noon(2026, 8, 14)
+    const { rows, total } = aggregateSamples({ groupBy: ['day'], asOf: cutoff }, [a, b, c])
+    // a and c sit at 8/15 noon (after the cutoff); b sits exactly on it.
+    expect(rows.map(r => r.day)).toEqual(['2026-08-14'])
+    expect(rows[0]!.requests).toBe(1)
+    expect(total.inputTokens).toBe(7)
+  })
+
+  it('returns no rows and zero totals for an empty corpus', () => {
+    const { rows, total } = aggregateSamples({ groupBy: ['day'] }, [])
+    expect(rows).toEqual([])
+    expect(total.totalTokens).toBe(0)
+  })
+})
+
+describe('UsageQuery service', () => {
+  const logs: Record<string, SessionEvent[]> = {
+    's-1': [
+      header(0, 'deepseek', 'deepseek-chat', noon(2026, 8, 15)),
+      message(1, 1, 1, noon(2026, 8, 15), usage()),
+    ],
+    's-2': [message(0, 1, 1, noon(2026, 8, 14), usage({ inputTokens: 7 }))],
+  }
+
+  const mount = async (
+    records: string[],
+    options: {
+      createdAt?: (id: string) => number
+      snapshotSource?: () => Record<string, string>
+      rawArtifacts?: Record<string, string>
+      rawSupported?: boolean
+      liveSessions?: Record<string, SessionEvent[]>
+      readCalls?: string[]
+    } = {},
+  ): Promise<{ ctx: Context; dispose: () => Promise<void>; reads: string[] }> => {
+    const ctx = new Context()
+    const createdAt = options.createdAt ?? (() => noon(2026, 8, 15))
+    const reads: string[] = []
+    if (options.liveSessions !== undefined) {
+      const liveEvents = options.liveSessions
+      ctx.provide('sessions', {
+        get: (id: string) => (liveEvents[id] === undefined
+          ? undefined
+          : { header: { id }, events: liveEvents[id] }),
+      } as never)
+    }
+    ctx.provide('sessionQuery', {
+      listSessions: async () => records.map(id => ({
+        header: { id, createdAt: createdAt(id) },
+        live: true,
+        persisted: true,
+      })),
+      readSession: async (id: string) => {
+        reads.push(id)
+        options.readCalls?.push(id)
+        return { session: { id }, events: logs[id] ?? [] }
+      },
+    } as unknown as SessionQueryEngine)
+    if (options.snapshotSource !== undefined || options.rawArtifacts !== undefined || options.rawSupported === false) {
+      const source = options.snapshotSource
+      const artifacts = options.rawArtifacts
+      const rawSupported = options.rawSupported ?? true
+      ctx.provide('sessionPersistence', {
+        ...(source === undefined ? {} : { listSnapshots: async () => Object.entries(source())
+          .map(([id, revision]) => ({ header: { id }, revision })) }),
+        supportsRawArtifacts: rawSupported,
+        ...(rawSupported ? {
+          readRaw: async (id: string) => artifacts === undefined || artifacts[id] === undefined
+            ? undefined
+            : { meta: { id }, filename: 'session.jsonl', content: artifacts[id] },
+        } : {}),
+      } as never)
+    }
+    const fiber = await ctx.plugin(UsageQuery)
+    return { ctx, dispose: () => fiber.dispose(), reads }
+  }
+
+  it('aggregates across sessions and merges equal group keys', async () => {
+    const { ctx, dispose } = await mount(['s-1', 's-2'])
+    try {
+      const result = await ctx.usageQuery.query({ groupBy: ['model'] })
+      expect(result.rows).toEqual([
+        {
+          model: 'deepseek/deepseek-chat', requests: 1, inputTokens: 100, outputTokens: 50,
+          cacheReadTokens: 0, cacheWriteTokens: 0, reasoningTokens: 0, totalTokens: 150,
+        },
+        {
+          model: UNKNOWN_MODEL, requests: 1, inputTokens: 7, outputTokens: 50,
+          cacheReadTokens: 0, cacheWriteTokens: 0, reasoningTokens: 0, totalTokens: 57,
+        },
+      ])
+      expect(result.total.totalTokens).toBe(207)
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('returns an empty result when no sessions exist', async () => {
+    const { ctx, dispose } = await mount([])
+    try {
+      const result = await ctx.usageQuery.query({ groupBy: ['day', 'model', 'session'] })
+      expect(result.rows).toEqual([])
+      expect(result.total.totalTokens).toBe(0)
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('rejects an invalid request before touching the corpus', async () => {
+    const { ctx, dispose } = await mount(['s-1'])
+    try {
+      await expect(ctx.usageQuery.query({ groupBy: [] })).rejects.toThrow(/at least one/)
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('fails loudly when sessionQuery is not mounted', async () => {
+    const ctx = new Context()
+    const fiber = await ctx.plugin(UsageQuery)
+    try {
+      await expect(ctx.usageQuery.query({ groupBy: ['day'] })).rejects.toThrow(/not mounted/)
+    } finally {
+      await fiber.dispose()
+    }
+  })
+
+  it('rejects unknown configuration keys', () => {
+    expect(() => new UsageQuery(new Context(), { mystery: true } as never)).toThrow(/unknown key/)
+  })
+
+  it('caches persisted folds by revision and re-reads after a revision change', async () => {
+    const reads: string[] = []
+    const snapshots: Record<string, string> = { 's-1': 'rev-1', 's-2': 'rev-1' }
+    const { ctx, dispose } = await mount(['s-1', 's-2'], {
+      snapshotSource: () => snapshots,
+      readCalls: reads,
+    })
+    try {
+      await ctx.usageQuery.query({ groupBy: ['day'] })
+      await ctx.usageQuery.query({ groupBy: ['model'] })
+      expect(reads).toEqual(['s-1', 's-2'])
+      // A revision bump invalidates the cache entry.
+      snapshots['s-1'] = 'rev-2'
+      await ctx.usageQuery.query({ groupBy: ['day'] })
+      expect(reads).toEqual(['s-1', 's-2', 's-1'])
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('skips sessions created after the requested window end', async () => {
+    const reads: string[] = []
+    const { ctx, dispose } = await mount(['s-1', 's-2', 's-3'], {
+      createdAt: id => (id === 's-3' ? noon(2026, 8, 20) : noon(2026, 8, 15)),
+      readCalls: reads,
+    })
+    try {
+      const result = await ctx.usageQuery.query({ groupBy: ['day'], to: '2026-08-15' })
+      expect(reads).toEqual(['s-1', 's-2'])
+      expect(result.total.totalTokens).toBe(207)
+      // Without a window end every session is scanned.
+      await ctx.usageQuery.query({ groupBy: ['day'] })
+      expect(reads).toEqual(['s-1', 's-2', 's-1', 's-2', 's-3'])
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('evicts the oldest cache entry past the limit', async () => {
+    const ids = Array.from({ length: 510 }, (_, i) => `bulk-${i}`)
+    const snapshots = Object.fromEntries(ids.map(id => [id, 'r']))
+    const reads: string[] = []
+    const { ctx, dispose } = await mount(ids, { snapshotSource: () => snapshots, readCalls: reads })
+    try {
+      const result = await ctx.usageQuery.query({ groupBy: ['session'] })
+      expect(result.rows).toEqual([])
+      expect(reads).toHaveLength(510)
+      // The cache stayed bounded at 500 entries, so the 10 evicted sessions
+      // are re-read while the 500 retained ones are served from the cache.
+      await ctx.usageQuery.query({ groupBy: ['session'] })
+      expect(reads).toHaveLength(520)
+    } finally {
+      await dispose()
+    }
+  })
+
+  it('scans raw artifacts for persisted sessions instead of replaying them', async () => {
+    const reads: string[] = []
+    const raw = (turn: number, input: number): string => JSON.stringify({
+      type: 'assistant/message', seq: turn, time: noon(2026, 8, 15),
+      data: { turn, step: 1, message: { role: 'assistant', blocks: [] }, usage: { inputTokens: input, outputTokens: 1 } },
+    })
+    const { ctx, dispose } = await mount(['s-1', 's-2'], {
+      snapshotSource: () => ({ 's-1': 'r', 's-2': 'r' }),
+      rawArtifacts: { 's-1': [raw(1, 100), raw(2, 7)].join('\n') },
+      readCalls: reads,
+    })
