{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/dsh-client-runtime/client": [
        "./node_modules/@deepseek-ai/dsh-client-runtime/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-ui-sidebar/client": [
        "./node_modules/@deepseek-ai/dsh-client-ui-sidebar/lib/types/client/index.d.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "./node_modules/@deepseek-ai/dsh-client-locale/lib/types/client/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
